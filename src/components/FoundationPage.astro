---
import type { ChurchSettings } from "../lib/cms/types";

interface Props {
  title: string;
  description: string;
  settings: ChurchSettings;
}

const { title, description, settings } = Astro.props;
---

<section class="placeholder-page section">
  <div class="site-container">
    <p class="eyebrow">M1 foundation preview</p>
    <h1>{title}</h1>
    <p class="reading-width">{description}</p>
    <p class="reading-width">This route shell is in place so the shared layout, canonical metadata, navigation, synthetic content boundary, and no-JavaScript rendering can be tested before the visual homepage milestone.</p>
    <p><a class="button" href="/">Return home</a></p>
    <p class="reading-width">{settings.address.street} · {settings.region}</p>
  </div>
</section>
