---
import type { Sermon } from "../lib/cms/types";
import { formatDate } from "../lib/format";

interface Props {
  sermon: Sermon;
  featured?: boolean;
}

const { sermon, featured = false } = Astro.props;
const destination = `/sermons/${sermon.slug}`;
---

<article class:list={["sermon-card", featured && "sermon-card-featured"]}>
  <div class="sermon-card-meta">
    <span>{sermon.series?.title ?? "Sermon"}</span>
    <time datetime={sermon.date}>{formatDate(sermon.date)}</time>
  </div>
  <h3 class="sermon-card-title">{sermon.title}</h3>
  <p class="sermon-card-speaker">{sermon.speaker.name}{sermon.speaker.role ? ` · ${sermon.speaker.role}` : ""}</p>
  <p class="sermon-card-description">{sermon.description}</p>
  <a class="text-link sermon-card-link" href={destination}>
    Sermon details <span aria-hidden="true">↗</span>
  </a>
</article>
