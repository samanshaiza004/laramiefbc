---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Page not found" description="The page you requested could not be found." noindex>
  <section class="not-found-page section">
    <div class="site-container">
      <p class="eyebrow">404</p>
      <h1>That page isn’t here.</h1>
      <p><a class="button" href="/">Return to the homepage</a></p>
    </div>
  </section>
</BaseLayout>
