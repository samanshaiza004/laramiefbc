---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCmsContent } from "../lib/cms/content";

const { homepage, settings } = await getCmsContent();
---

<BaseLayout title={homepage.title} description={homepage.description}>
  <section class="foundation-hero section">
    <div class="site-container">
      <p class="eyebrow">M1 foundation preview</p>
      <h1 class="display-heading">First Baptist Church of Laramie</h1>
      <p class="foundation-hero-copy">The shared site foundation is ready for the visual homepage proof: a clear, local, welcoming website for people looking for a church in Laramie.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="button button-on-dark" href="/visit">Plan Your Visit</a>
        <a class="button button-secondary" href="/sermons">Watch Latest Sermon</a>
      </div>
    </div>
  </section>

  <section class="service-strip" aria-labelledby="service-heading">
    <div class="site-container service-strip-grid">
      <div>
        <p class="eyebrow" id="service-heading">Sunday information</p>
        <p class="m-0 max-w-xl">Service times and location will be published here only after church leadership verifies them.</p>
      </div>
      {settings.services.map((service) => (
        <div class="service-strip-item">
          <p class="service-strip-label">{service.label}</p>
          <p class="service-strip-time">{service.day} · {service.time}</p>
          <p class="m-0 text-sm">{service.notes}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="next-heading">
    <div class="site-container">
      <p class="eyebrow">What comes next</p>
      <h2 class="section-heading" id="next-heading">A careful welcome is being built.</h2>
      <p class="reading-width mt-6 text-lg text-[var(--color-muted-foreground)]">M2 will turn this foundation into the finished homepage using verified church photography, practical Sunday information, and an editorial visual system tuned to Laramie.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="button" href="/about">Who We Are</a>
        <a class="button button-secondary" href="/contact">Contact the Church</a>
      </div>
    </div>
  </section>
</BaseLayout>
