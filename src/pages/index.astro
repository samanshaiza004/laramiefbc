---
import BaseLayout from "../layouts/BaseLayout.astro";
import CmsImage from "../components/CmsImage.astro";
import { churchPhotos } from "../data/church-photos";
import { getCmsContent } from "../lib/cms/content";

const { aboutPage, homepage, settings } = await getCmsContent();
---

<BaseLayout title={homepage.title} description={homepage.description}>
  <section class="home-hero">
    <div class="site-container home-hero-stage">
      <div class="home-hero-heading">
        <p class="home-hero-location">First Baptist Church · Laramie, Wyoming</p>
        <h1 class="home-hero-title"><span>First Baptist</span><span>Church</span></h1>
      </div>
      <figure class="home-photo home-hero-photo">
        <CmsImage
          source={churchPhotos.hero.source}
          alt={churchPhotos.hero.alt}
          loading="eager"
          fetchpriority="high"
          sizes="(max-width: 699px) 100vw, 57vw"
          class="home-photo-image"
        />
      </figure>
      <div class="home-hero-claim">
        <p>{aboutPage.mission}</p>
        <div class="home-hero-actions">
          <a class="button button-on-dark" href="/visit">Plan Your Visit</a>
          <a class="button button-secondary" href="/sermons">Watch Latest Sermon</a>
        </div>
      </div>
    </div>
  </section>

  <section class="home-service-band" aria-labelledby="service-heading">
    <div class="site-container home-service-grid">
      <div class="home-service-intro">
        <p class="eyebrow" id="service-heading">At First Baptist</p>
        <h2>Sundays</h2>
        <p>Come for worship, conversation, and a community learning to follow Jesus together.</p>
      </div>
      <div class="home-service-times">
        {settings.services.map((service) => (
          <div class="home-service-time">
            <p class="home-service-label">{service.label}</p>
            <p class="home-service-value">{service.day} <span>·</span> {service.time}</p>
            <p class="home-service-note">{service.notes}</p>
          </div>
        ))}
      </div>
      <address class="home-service-address">
        <span class="home-service-address-label">Find us</span>
        <span>{settings.address.street}</span>
        <span>{settings.address.locality}, {settings.address.region} {settings.address.postalCode}</span>
        <a class="text-link" href={settings.directionsUrl}>Get directions <span aria-hidden="true">↗</span></a>
      </address>
    </div>
  </section>

  <section class="section home-welcome" aria-labelledby="welcome-heading">
    <div class="site-container home-welcome-grid">
      <div class="home-welcome-copy">
        <p class="eyebrow">New here?</p>
        <h2 class="section-heading" id="welcome-heading">You don’t have to know the words before you walk in.</h2>
        <p class="home-lead">If you are looking for a church in Laramie, start with a question, a Sunday, or a conversation. We want your first visit to feel clear and human.</p>
        <a class="text-link home-arrow-link" href="/visit">Plan your visit <span aria-hidden="true">↗</span></a>
      </div>
      <figure class="home-photo home-welcome-photo">
        <CmsImage
          source={churchPhotos.welcome.source}
          alt={churchPhotos.welcome.alt}
          sizes="(max-width: 699px) 100vw, 50vw"
          class="home-photo-image"
        />
      </figure>
    </div>
  </section>

  <section class="home-pathways section" aria-labelledby="pathways-heading">
    <div class="site-container">
      <div class="home-section-intro">
        <p class="eyebrow">Take a next step</p>
        <h2 class="section-heading" id="pathways-heading">Find your way in.</h2>
      </div>
      <div class="pathway-list">
        <a class="pathway-row" href="/about">
          <span class="pathway-label">Who we are</span>
          <span class="pathway-description">Our story, beliefs, and the values that shape life together.</span>
          <span class="pathway-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="pathway-row" href="/connect">
          <span class="pathway-label">Get connected</span>
          <span class="pathway-description">Find a place to serve, ask a question, or begin a conversation.</span>
          <span class="pathway-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="pathway-row" href="/sermons">
          <span class="pathway-label">Listen first</span>
          <span class="pathway-description">Explore the sermon archive when you want to hear the teaching before you arrive.</span>
          <span class="pathway-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="home-media-section section" aria-labelledby="media-heading">
    <div class="site-container home-media-grid">
      <div class="home-media-art home-photo">
        <CmsImage
          source={churchPhotos.history.source}
          alt={churchPhotos.history.alt}
          sizes="(max-width: 699px) 100vw, 50vw"
          class="home-photo-image"
        />
      </div>
      <div class="home-media-copy">
        <p class="eyebrow">A local church with a long memory</p>
        <h2 class="section-heading" id="media-heading">Laramie has been part of our story from the beginning.</h2>
        <p class="home-lead">{aboutPage.history[0].paragraphs[0]}</p>
        <a class="text-link home-arrow-link" href="/about">Read our story <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="home-gallery section" aria-labelledby="gallery-heading">
    <div class="site-container">
      <div class="home-gallery-intro">
        <p class="eyebrow">Around First Baptist</p>
        <h2 class="section-heading" id="gallery-heading">A church is made of people, places, and ordinary days.</h2>
        <p class="home-lead">A few glimpses of the life we share in and around our Laramie home.</p>
      </div>
      <div class="home-photo-grid">
        {churchPhotos.gallery.map((photo, index) => (
          <figure class:list={["home-gallery-photo", `home-gallery-photo-${index + 1}`]}>
            <CmsImage source={photo.source} alt={photo.alt} sizes="(max-width: 699px) 100vw, (max-width: 999px) 50vw, 33vw" class="home-photo-image" />
            <figcaption>{photo.label}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="home-archives section" aria-labelledby="archives-heading">
    <div class="site-container">
      <div class="home-section-intro home-section-intro-wide">
        <p class="eyebrow">Keep in touch</p>
        <h2 class="section-heading" id="archives-heading">There is more to discover.</h2>
      </div>
      <nav class="archive-links" aria-label="Explore more">
        <a class="archive-link" href="/sermons">
          <span>
            <span class="archive-kicker">Sermons</span>
            <span class="archive-title">Hear the teaching before you arrive.</span>
          </span>
          <span class="archive-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="archive-link" href="/events">
          <span>
            <span class="archive-kicker">Events</span>
            <span class="archive-title">Make room for community.</span>
          </span>
          <span class="archive-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="archive-link" href="/contact">
          <span>
            <span class="archive-kicker">Questions</span>
            <span class="archive-title">Contact the church.</span>
          </span>
          <span class="archive-arrow" aria-hidden="true">↗</span>
        </a>
      </nav>
    </div>
  </section>

  <section class="home-visit-cta section" aria-labelledby="visit-cta-heading">
    <div class="site-container home-visit-cta-inner">
      <div>
        <p class="eyebrow">Plan a Sunday</p>
        <h2 class="section-heading" id="visit-cta-heading">We’ll leave the light on.</h2>
      </div>
      <div class="home-visit-details">
        <p>{settings.address.street}<br />{settings.address.locality}, {settings.address.region} {settings.address.postalCode}</p>
        <p>{settings.services[0]?.day} · {settings.services[0]?.time}</p>
        <a class="button button-on-dark" href="/visit">Plan Your Visit</a>
      </div>
    </div>
  </section>
</BaseLayout>
