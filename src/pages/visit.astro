---
import BaseLayout from "../layouts/BaseLayout.astro";
import VisitContent from "../components/VisitContent.astro";
import { getCmsContent } from "../lib/cms/content";

const { visitPage, settings } = await getCmsContent();
---
<BaseLayout title={visitPage.title} description={visitPage.description}>
  <VisitContent visitPage={visitPage} settings={settings} />
</BaseLayout>
