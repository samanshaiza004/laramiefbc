---
import BaseLayout from "../layouts/BaseLayout.astro";
import SermonsContent from "../components/SermonsContent.astro";
import { getCmsContent } from "../lib/cms/content";

const { sermons, settings } = await getCmsContent();
---
<BaseLayout title="Sermons" description="Hear the teaching and explore the sermon archive from First Baptist Church of Laramie.">
  <SermonsContent sermons={sermons} settings={settings} />
</BaseLayout>
