---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { getCmsContent } from "../lib/cms/content";
import { absoluteAssetUrl, canonicalUrl } from "../lib/site-url";
import { createChurchStructuredData } from "../lib/structured-data";
import { siteConfig } from "../site-config";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const { source, settings } = await getCmsContent();

if (!Astro.site) {
  throw new Error("Astro.site is required by BaseLayout.");
}

const canonical = canonicalUrl(Astro.site, Astro.url.pathname);
const socialImage = absoluteAssetUrl(Astro.site, "/og-default.svg");
const structuredData = createChurchStructuredData(settings, Astro.site);
const pageDescription = description ?? settings.description;
const displayTitle = `${title} | ${settings.name}`;
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#17222a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={new URL("/sitemap-index.xml", Astro.site)} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.name} />
    <meta property="og:title" content={displayTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={displayTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <title>{displayTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    {source === "local" && <div class="foundation-notice" role="status">Visual preview: synthetic content is shown here for development only.</div>}
    <Header settings={settings} />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer settings={settings} />
    <script>import "../scripts/mannerhtml";</script>
  </body>
</html>
