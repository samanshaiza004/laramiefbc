# Public canonical origin. Use the eventual production domain only after ownership is confirmed.
SITE_URL=http://localhost:4321

# CMS selection is explicit. Use local only for development and tests.
CMS_SOURCE=local

# Required by the Sanity integration in production.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Used only by the server-side contact function; never expose these as PUBLIC_*.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_EMAIL_API_KEY=

# The contact function currently sends through Resend's email API.
