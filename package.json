    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "latest",
    "@types/node": "^24.10.1",
    "astro-eslint-parser": "^1.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-astro": "^1.5.0",
